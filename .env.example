# Database
MONGODB_URI=mongodb://mongo:27017/pdf-api

# Base URL
BASE_URL=https://pdfify.pro/

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Email Configuration
BETA_NOTIFICATION_EMAIL=your-email@example.com
ZEPTO_USER=emailapikey
ZEPTO_PASS=your-zepto-key-here

# JWT & Session
JWT_SECRET=your-super-secret-jwt-key
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-encryption-key

# URLs
SUCCESS_URL=https://pdfify.pro/success.html
CANCEL_URL=https://pdfify.pro/cancel.html

# Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=0x4AAAAAAB...

# ICC Profiles for PDF/A
ICC_PROFILE_PATH=./server/Helpers/sRGB_v4_ICC_preference.icc
PDFA_ICC_PROFILE=./server/Helpers/sRGB_v4_ICC_preference.icc

# Java PDF Service
JAVA_PDF_SERVICE_URL=http://java-pdf-service:8080

# Shopify Configuration
# CRITICAL: For webhooks defined in shopify.app.toml, HMAC verification uses SHOPIFY_API_SECRET
# SHOPIFY_API_SECRET and SHOPIFY_CLIENT_SECRET must be the SAME value (your API secret from Partners dashboard)
# Get these from: https://partners.shopify.com/XXX/apps/YYY/api-credentials
SHOPIFY_CLIENT_ID=your-client-id-from-partners-dashboard
SHOPIFY_CLIENT_SECRET=shpss_your-api-secret-here
SHOPIFY_API_SECRET=shpss_your-api-secret-here
SHOPIFY_WEBHOOK_SECRET=shpss_your-webhook-secret-here
SHOPIFY_REDIRECT_URL=https://pdfify.pro/api/shopify/callback

# Force Plan (for testing - remove in production)
# FORCE_PLAN=pro
