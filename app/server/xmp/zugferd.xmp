<?xpacket begin="\uFEFF" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="PDFify">
  <rdf:RDF 
      xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
      xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"
      xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
      xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
      xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#"
      xmlns:pdfaAF="http://www.aiim.org/pdfa/ns/af/"
      xmlns:dc="http://purl.org/dc/elements/1.1/"
      xmlns:xmp="http://ns.adobe.com/xap/1.0/"
      xmlns:zf="urn:zugferd:pdfa:CrossIndustryDocument:invoice:2p1:basic">

    <!-- PDF/A Identification -->
    <rdf:Description rdf:about="">
      <pdfaid:part>3</pdfaid:part>
      <pdfaid:conformance>B</pdfaid:conformance>
    </rdf:Description>

    <!-- Document metadata -->
    <rdf:Description rdf:about="">
      <dc:format>application/pdf</dc:format>
      <xmp:CreatorTool>PDFify API</xmp:CreatorTool>
    </rdf:Description>

    <!-- ZUGFeRD identification -->
    <rdf:Description rdf:about="">
      <zf:DocumentFileName>zugferd-invoice.xml</zf:DocumentFileName>
      <zf:DocumentType>INVOICE</zf:DocumentType>
      <zf:Version>2.1</zf:Version>
      <zf:ConformanceLevel>BASIC</zf:ConformanceLevel>
    </rdf:Description>

    <!-- Schema Extension Declaration -->
    <rdf:Description rdf:about="">
      <pdfaExtension:schemas>
        <rdf:Bag>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>ZUGFeRD PDFA Extension Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>urn:zugferd:pdfa:CrossIndustryDocument:invoice:2p1:basic</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>zf</pdfaSchema:prefix>
          </rdf:li>
        </rdf:Bag>
      </pdfaExtension:schemas>
    </rdf:Description>

    <!-- Associated File Info -->
    <rdf:Description rdf:about="">
      <pdfaAF:attachedFile>
        <rdf:Bag>
          <rdf:li rdf:parseType="Resource">
            <pdfaAF:AFRelationship>Data</pdfaAF:AFRelationship>
            <pdfaAF:UF>zugferd-invoice.xml</pdfaAF:UF>
            <pdfaAF:MIME>application/xml</pdfaAF:MIME>
            <pdfaAF:Desc>ZUGFeRD Invoice XML</pdfaAF:Desc>
          </rdf:li>
        </rdf:Bag>
      </pdfaAF:attachedFile>
    </rdf:Description>

  </rdf:RDF>
</x:xmpmeta>
