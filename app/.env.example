# PDFify Environment Variables

# ===================================
# Database Configuration
# ===================================
MONGODB_URI=mongodb://mongo:27017/pdfify

# ===================================
# Security & Authentication
# ===================================
SESSION_SECRET=your_session_secret_here_64_chars_minimum
JWT_SECRET=your_jwt_secret_here_64_chars_minimum
ENCRYPTION_KEY=your_32_character_hex_encryption_key_here

# ===================================
# Stripe Payment Configuration
# ===================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (for token purchases)
STRIPE_PRICE_ID_1000=price_1000_pages
STRIPE_PRICE_ID_5000=price_5000_pages
STRIPE_PRICE_ID_10000=price_10000_pages

# ===================================
# Shopify Integration
# ===================================
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# ===================================
# Email Configuration
# ===================================
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# ===================================
# Cloudflare Turnstile (CAPTCHA)
# ===================================
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ===================================
# ZUGFeRD / PDF/A-3b Service
# ===================================
# Python service for guaranteed PDF/A-3b compliance
# Default: http://python-service:5000 (Docker internal network)
ZUGFERD_SERVICE_URL=http://python-service:5000

# ===================================
# Application Configuration
# ===================================
NODE_ENV=development
BASE_URL=http://localhost:3002
PORT=3000

# Development flags
DEBUG_MODE=true
FORCE_PLAN=  # Leave empty for normal operation, or set to: free, premium, pro

# ===================================
# PDF Generation Configuration
# ===================================
# ICC Color Profile path (for PDF/A compliance)
PDFA_ICC_PROFILE=/app/server/Helpers/sRGB2014.icc

# PDFBox JAR path (if using Java-based compliance)
PDFBOX_JAR_PATH=/app/server/Helpers/preflight-app-2.0.24.jar
